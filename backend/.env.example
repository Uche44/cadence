# Copy to backend/.env and fill in. Never commit backend/.env.
#
# Development needs none of these to boot. Production refuses to start unless
# CADENCE_SECRET_KEY, CADENCE_LLM_API_KEY, and CADENCE_LLM_MODEL are present.

CADENCE_ENVIRONMENT=development
CADENCE_DATABASE_URL=sqlite:///./cadence.db
CADENCE_SECRET_KEY=

# Groq is OpenAI-compatible, so any compatible provider works by changing the base URL.
CADENCE_LLM_BASE_URL=https://api.groq.com/openai/v1
CADENCE_LLM_API_KEY=
CADENCE_LLM_MODEL=
